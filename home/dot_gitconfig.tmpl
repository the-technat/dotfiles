{{ if not .devcontainer -}}
[user]
  email = {{ .email }}
  name = {{ .name }}
  {{- if eq .osid "darwin" }}
  signingkey = ~/.ssh/ssh_signing.pub # symlink to the actual secretive pub key
  {{- end }}
  {{- if eq .chezmoi.os "linux" }}
  signingkey = ~/.ssh/id_ed25519
  {{- end }}
[pull]
  rebase = true
[init]
  defaultBranch = main
[push]
  autoSetupRemote = true
[gpg]
  format = ssh
[commit]
  gpgSign = true
[core]
  editor = vim
[include]
  path = .gitcustom
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[credential]
  helper = store
[includeIf "hasconfig:remote.*.url:git@gitlab.fhnw.ch:*/**"]
  path = "~/.gitconfig.gitlab"
[includeIf "hasconfig:remote.*.url:https://github.com/postch*/**"]
  path = "~/.gitconfig.ghe"
{{ end -}}
