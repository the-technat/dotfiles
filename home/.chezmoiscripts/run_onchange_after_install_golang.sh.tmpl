#!/usr/bin/env zsh

VERSION=1.24.5 # see https://go.dev/dl/
ARCH={{ .chezmoi.arch }}
OS={{ .chezmoi.os }}

# first remove the old installation
if [ -d "{{ .bindir }}/go" ]
then
rm -rf {{ .bindir }}/go
fi

curl -sSL -o /tmp/go.tar.gz https://go.dev/dl/go$VERSION.$OS-$ARCH.tar.gz
tar -C {{ .bindir }} -xzf /tmp/go.tar.gz
rm -rf /tmp/go.tar.gz
