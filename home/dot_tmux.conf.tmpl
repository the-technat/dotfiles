set -g @plugin 'tmux-plugins/tmux-yank'          # Copy-paste with the mouse
set -g @plugin 'smart-splits-nvim/backend-tmux'  # Native pane/window navigation with nvim
#set -g @plugin 'erikw/tmux-powerline'           # Fancy status bar
set -g @catppuccin_flavour 'latte'               # or frappe, macchiato, mocha

set -g history-limit 500000
set -g default-terminal "tmux-256color"

bind-key | split-window -h -c "#{pane_current_path}"                                        # prefered hsplit
bind-key - split-window -v -c "#{pane_current_path}"                                        # prefered vsplit
bind-key S if-shell -F '#{==:#{status},off}' 'set-option status on' 'set-option status off' # toggle tmux status bar (visual noise when presenting)
bind-key c new-window -c "#{pane_current_path}"                                             # open new pane in same dir
bind-key r source-file ~/.tmux.conf \; display-message "Config reloaded"                    # reload config

set-window-option -g mode-keys vi
set-window-option -g status-keys vi

set-option -g focus-events on # nvim (lua) setting rec 20220630
set-option -sg escape-time 0  # https://github.com/LazyVim/LazyVim/discussions/658

set -g @yank_selection_mouse 'clipboard' # mouse yanks should go to clipboard

set -g @smart-splits_at_edge 'split'  # behavior when splitting smart-splits, align with nvim
set -g bell-action none               # silence please!

run '~/.tmux/plugins/tpm/tpm'                    # initialize TPM, end of file
