{
  "workbench.colorTheme": "MacOS Modern Light - Xcode Default",
  "workbench.preferredDarkColorTheme": "MacOS Modern Dark - Xcode Default",
  "workbench.preferredLightColorTheme": "Catppuccin Latte",
  "workbench.iconTheme": "catppuccin-latte",
  "workbench.productIconTheme": "macos-modern",
  "editor.fontFamily": "FiraCode Nerd Font,Menlo, Monaco, 'Courier New', monospace",
  "window.customTitleBarVisibility": "windowed",
  "workbench.editor.showTabs": "none",
  "workbench.startupEditor": "none",
  "redhat.telemetry.enabled": false,
  "explorer.confirmDelete": false,
  "editor.accessibilitySupport": "off",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "vim.useSystemClipboard": true,
  "terminal.integrated.copyOnSelection": true,
  "search.globalFindClipboard": true,
  "editor.find.globalFindClipboard": true,
  "explorer.confirmDragAndDrop": false,
  "go.toolsManagement.autoUpdate": true,
  "go.lintOnSave": "file",
  "go.showWelcome": false,
  "window.autoDetectColorScheme": true,
  "editor.tabSize": 2,
  "update.showReleaseNotes": false,
  "makefile.configureOnOpen": true,
  "docker.extension.enableComposeLanguageServer": false,
  "mirrord.promptUsingDefaultConfig": false,
  "mirrord.promptUsingBinary": false,
  "mirrord.promptOutdated": false,
  "mirrord.promptMirrordForTeams": false,
  "window.systemColorTheme": "auto",
  "java.help.showReleaseNotes": false,
  "editor.formatOnSave": true,
  "git.openRepositoryInParentFolders": "always",
  "editor.wordWrapColumn": 200,
  "terminal.integrated.stickyScroll.enabled": false,
  "workbench.settings.showAISearchToggle": false,
  "chat.disableAIFeatures": true,
  "java.debug.settings.onBuildFailureProceed": true,
  "java.configuration.updateBuildConfiguration": "automatic",
  "yaml.format.enable": false,
  "git.blame.editorDecoration.enabled": true,
  "git.blame.statusBarItem.enabled": false,
  "todohighlight.keywords": [
    "TODO",
    "QUESTION",
    "?",
    "Q"
  ],
  "debug.breakpointsView.presentation": "tree",
  "terminal.integrated.initialHint": false,
  "workbench.activityBar.compact": true,
  "workbench.sideBar.location": "right",
  "java.maven.downloadSources": true,
  "git.autofetch": true,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "editor.minimap.enabled": false,
  "java.project.encoding": "warning",
  "workbench.editorAssociations": {
    "*.xml": "java.formatterSettingsEditor"
  },
}