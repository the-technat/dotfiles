// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "languages": {
    "Java": {
      "auto_indent": "preserve_indent",
      "tab_size": 4,
    },
  },
  "autosave": "on_focus_change",
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "terminal": {
    "font_size": 14.0,
    "copy_on_select": true,
    "line_height": "standard",
    "env": {
      "EDITOR": "zed --wait",
    },
  },
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "tab_bar": {
    "show": false,
  },
  "minimap": {
    "show": "never",
  },
  "buffer_font_family": "FiraCode Nerd Font",
  "tab_size": 2,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "profiles": {
    "desk": {
      "settings": {
        "ui_font_size": 16,
        "buffer_font_size": 16,
        "terminal": {
          "font_size": 16,
        },
      },
    },
    "present": {
      "settings": {
        "tab_bar": {
          "show": true,
        },
        "ui_font_size": 16,
        "buffer_font_size": 20,
        "terminal": {
          "font_size": 20,
          "line_height": "comfortable",
          "blinking": "off",
          "default_height": 500,
        },
      },
    },
  },
}
