{{ if eq .chezmoi.os "darwin" -}}
# orbstack injects the line below automatically into .zprofile but we want to manage that
source ~/.orbstack/shell/init.zsh 
{{   if contains "arm" (output "uname" "-p" | trim) -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ else -}}
eval "$(/usr/local/bin/brew shellenv)"
{{   end -}}
PATH="$PATH:$(brew --prefix openjdk)/libexec/openjdk.jdk:/Users/{{ .chezmoi.username }}/go/bin:/Users/{{ .chezmoi.username }}/.local/bin"
{{ end -}}
{{ if and (eq .chezmoi.os "linux") (not .devcontainer) -}}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
PATH="$PATH:$(brew --prefix openjdk)/libexec/openjdk.jdk:/home/{{ .chezmoi.username }}/go/bin:/home/{{ .chezmoi.username }}/.local/bin"
{{ end -}}

# exports nvm and it's installations to PATH
NVM_PREFIX=$(brew --prefix nvm)
[ -s "$NVM_PREFIX/nvm.sh" ] && \. "$NVM_PREFIX/nvm.sh"  # This loads nvm
[ -s "$NVM_PREFIX/etc/bash_completion.d/nvm" ] && \. "$NVM_PREFIX/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

# exports homebrew-tooling autocompletion to zsh
FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
