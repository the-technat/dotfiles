export ZSH="$HOME/.oh-my-zsh"
ZSH_CUSTOM=~/.omz_custom

{{ if .devcontainer -}}

ZSH_THEME="random"
plugins=(git fzf sudo helm kubectl cp extract terraform aws docker)

{{ end }}
{{ if eq .chezmoi.os "darwin" -}}

ZSH_THEME="agnoster"
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion
export PATH="/opt/homebrew/opt/openjdk@21/bin:$PATH"
# orbstack injects the line below automatically into .zprofile but we want to manage that
source ~/.orbstack/shell/init.zsh 2>/dev/null 
plugins=(git fzf sudo helm kubectl cp extract terraform aws docker)

{{ end -}}
{{ if and (eq .chezmoi.os "linux") (not .devcontainer) -}}

ZSH_THEME="robbyrussell"
export NVM_DIR="$HOME/.nvm"
[ -s "/home/linuxbrew/.linuxbrew/opt/nvm/nvm.sh" ] && \. "/home/linuxbrew/.linuxbrew/opt/nvm/nvm.sh"  # This loads nvm
[ -s "/home/linuxbrew/.linuxbrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/home/linuxbrew/.linuxbrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion
export PATH="/home/linuxbrew/.linuxbrew/opt/openjdk@21/bin:$PATH" 
plugins=(ssh-agent git fzf sudo helm kubectl cp extract terraform aws docker)

{{ end -}}


DISABLE_AUTO_UPDATE="true" # because chezmoi manages this

COMPLETION_WAITING_DOTS="true"

FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
source $ZSH/oh-my-zsh.sh

DEFAULT_USER={{ .chezmoi.username }}
prompt_context(){}

