export ZSH="$HOME/.oh-my-zsh"
ZSH_CUSTOM=~/.omz_custom

{{ if .devcontainer -}}

ZSH_THEME="random"
plugins=(git fzf sudo helm kubectl cp extract terraform aws docker)

{{ end }}
{{ if eq .chezmoi.os "darwin" -}}

ZSH_THEME="agnoster"
plugins=(git fzf sudo helm kubectl cp extract terraform aws docker)

{{ end -}}
{{ if and (eq .chezmoi.os "linux") (not .devcontainer) -}}

ZSH_THEME="robbyrussell"
plugins=(ssh-agent git fzf sudo helm kubectl cp extract terraform aws docker)

{{ end -}}


DISABLE_AUTO_UPDATE="true" # because chezmoi manages this
COMPLETION_WAITING_DOTS="true"

FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
source $ZSH/oh-my-zsh.sh

DEFAULT_USER={{ .chezmoi.username }}
prompt_context(){}
